# Application Server Port
PORT=3000

# Store production secrets only in the deployment secret manager.
MONGODB_URI=mongodb://127.0.0.1:27017/legal-metrology
JWT_SECRET=replace-with-a-random-64-character-secret
JWT_EXPIRES_IN=15m

PUBLIC_APP_URL=https://your-domain.example
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
GEOCODER_URL=https://nominatim.openstreetmap.org

# Razorpay server credentials; never expose the secret to the frontend.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
ALLOW_DEMO_PAYMENTS=false

# Base64-encoded PKCS8 Ed25519 private key for certificate signing.
CERTIFICATE_PRIVATE_KEY=
CERTIFICATE_KEY_ID=primary
SEED_DEMO_DATA=false
SEED_DEMO_PASSWORD=

# Comma-separated exact origins.
CORS_ORIGIN=https://your-domain.example
NODE_ENV=production
